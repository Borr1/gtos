{
  "schema": "gtos.jev.complete_state.v0",
  "as_of_ict": "2026-09-21T06:04:21+07:00",
  "purpose": "Starve-proof typed state for every Choice/Score/Noul call. Static code stays envelope. Fail-closed if full_state_dark or Jev dark.",
  "doctrine": "JEV_EVERYWHERE_DOCTRINE_20260921.md",
  "never_broker_place_from_this_module": true,
  "never_invent_news_protocol": true,
  "never_invent_atr_or_regime": true,
  "never_merge_dig3r_into_module_atr": true,
  "global_sleeve_select_apply_default": 0,
  "place_path": "OPEN_CANDIDATE_AFTER_HIST_PROVE",
  "required_fields": [
    {"name": "schema", "type": "const gtos.jev.complete_state.v0", "req": true},
    {"name": "symbol", "type": "str", "req": true},
    {"name": "broker_symbol", "type": "str", "req": true, "notes": "canonical or broker alias from build_slots; STATE_MISSING if unresolvable"},
    {"name": "session_day", "type": "date-iso", "req": true},
    {"name": "decision_bar_iso", "type": "str", "req": true},
    {"name": "session_bucket", "type": "enum[asia,london,ny,overlap,off]", "req": true, "notes": "overlap is FIRST-CLASS; gold_state.sessions.named currently folds 12-16z into ny"},
    {"name": "alive_sleeves", "type": "list[str]", "req": true},
    {"name": "alive_menu", "type": "list[{tag,phi,keep_prior,affinity,escape}]", "req": true},
    {"name": "selected_sleeve_candidate", "type": "str|null", "req": false},
    {"name": "conflict_set", "type": "list[{a,b,relation,side,scope,kind}]", "req": true},
    {"name": "regime_tag", "type": "str|PENDING", "req": true, "notes": "hydrate-when-present; never invent S14"},
    {"name": "conf_band", "type": "str|PENDING", "req": true},
    {"name": "session_fit", "type": "str|PENDING", "req": true},
    {"name": "phi", "type": "float|null", "req": true},
    {"name": "phi_by_sleeve", "type": "map[str,float]", "req": true},
    {"name": "cost", "type": "object{spread_r,total_cost_r,commission_r,max_total_cost_r,source}", "req": true},
    {"name": "occupancy", "type": "object{sleeve_holds_symbol,broker_open_symbols,same_cycle_placed,n_open_book,already_placed_today,isolated_reentry_legal,minutes_since_flat}", "req": true},
    {"name": "account", "type": "object{login,ns,equity_r,dd_wall_r,soft_daily_stop}", "req": true},
    {"name": "hard_off_hit", "type": "str|null", "req": true},
    {"name": "remint", "type": "object{orig_stops_today,last_exit_class,minutes_since_exit,two_stop_armed}", "req": true},
    {"name": "news_join", "type": "object|STATE_MISSING", "req": false, "notes": "honest missing OK — NEVER invent NEWS_PROTOCOL"},
    {"name": "full_state_dark", "type": "bool", "req": true},
    {"name": "n_incomplete", "type": "int", "req": true},
    {"name": "place_context", "type": "object{writer_ready,authority,last_refusal_class,ticket_draft_fp}", "req": true},
    {"name": "lens", "type": "object{name,atr_source,invented}", "req": true, "notes": "Module_ATR honesty: atr from blotter/geometry or STATE_MISSING — never invent"},
    {"name": "armed_source", "type": "enum[research_armed_tags,live_armed,injected]", "req": true},
    {"name": "affinity", "type": "object{symbol,keep_priors,held}", "req": true}
  ],
  "pending_tokens": ["PENDING", "PENDING_SHADOW", "", null],
  "state_missing_token": "STATE_MISSING",
  "full_state_dark_rule": {
    "true_when": [
      "identity.symbol missing",
      "alive_sleeves empty AND affinity keep-priors empty AND compose fail_closed",
      "geometry_alone AND regime_tag PENDING AND not in research overlay",
      "n_incomplete of REQUIRED completeness keys >= dark_threshold (default 8 of 12 core)",
      "assembler exception / books unreadable for primary"
    ],
    "effect": "Choice A_STAND_DOWN fail-closed; never invent voters to look complete"
  },
  "n_incomplete_keys": [
    "symbol",
    "broker_symbol",
    "session_bucket",
    "alive_sleeves",
    "conflict_set",
    "regime_tag",
    "conf_band",
    "session_fit",
    "phi",
    "cost.spread_r",
    "occupancy.n_open_book",
    "account.login",
    "remint.orig_stops_today",
    "news_join",
    "place_context.writer_ready",
    "lens.atr_source"
  ],
  "session_bucket_map": {
    "asia": "utc_hour in (0,7)",
    "london": "utc_hour in [7,12)",
    "overlap": "utc_hour in [12,16) FIRST-CLASS (gold_state currently folds into ny)",
    "ny": "utc_hour in [16,21)",
    "off": "utc_hour>=21 or utc_hour==0 or friday_cutoff>=16z"
  },
  "conflict_cells": [
    {"symbol": "XAUUSD", "a": "dsp_three_fresh*", "b": "dsp_spring*", "relation": "TRUE_CONFLICT", "scoped_env": "GTOS_JEV_SLEEVE_SELECT_APPLY_XAU_CONFLICT"},
    {"symbol": "GBPJPY", "a": "vss*", "b": "sub_mid*", "relation": "SIDE_AWARE", "scoped_env": "GTOS_JEV_SLEEVE_SELECT_APPLY_GBPJPY_CONFLICT"},
    {"symbol": "EURUSD", "a": "asian_fade", "b": "sub_mid_dn_re_proxy_eurusd*", "relation": "KEEP_ALL_DUAL_POS", "scoped_env": "GTOS_JEV_SLEEVE_SELECT_APPLY_EURUSD_KEEP_ALL"}
  ],
  "consumers": [
    "jev_client.evaluate(state)",
    "policy_c_admit.evaluate_policy_c",
    "sleeve_select.build_sleeve_select_menu",
    "compose.compose_shadow",
    "apply_size.apply_named_tilts",
    "cycle.run_fluid_gate_cycle",
    "conf_gate.log_conf_gate",
    "regime_gate.evaluate_s14",
    "a1_log.observe"
  ]
}

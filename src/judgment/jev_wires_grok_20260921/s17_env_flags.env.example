# DRAFT ONLY — 17_residual_static_admission_governor
# Do not export on VPS / W7 / redacted_account. Chair APPLY later after Challenge hist-prove.
# place=false. Never broker send.

# Observe governor Score/Choice/Noul after evaluate_governor. Default-off.
GTOS_JEV_ADMISSION_SHADOW=0

# APPLY of governor Score onto size_cap_multiplier. MUST stay 0 this session.
GTOS_JEV_ADMISSION_APPLY=0

# Score family: derisking_into_maxdd_wall, profit_target_protect, stress ladder/coloss,
# kelly_lite, vol_level_tilt, learning tilt, symbol_damage RISK_REDUCE.
# When APPLY=0 this only logs.
GTOS_JEV_ADMISSION_SIZE_SCORE=0

# Choice BLOCK|DERISK_TRIM|STAND at soft_daily_stop_reached (-3%).
# Dark / APPLY=0 => keep integer BLOCK. Cannot reopen past remaining room to -5%.
GTOS_JEV_ADMISSION_SOFT_STOP_CHOICE=0

# Score which correlated units to keep when gross cap binds (replace FFD shed).
GTOS_JEV_ADMISSION_SHED_SCORE=0

# Score leader_impulse_veto / session_active_stack size-up (live overlays=false).
GTOS_JEV_ADMISSION_OVERLAY_SCORE=0

# If Jev dark / skip / error: keep static envelope. Never widen. Never un-trip circuit.
GTOS_JEV_ADMISSION_FAIL_CLOSED=1

# Swarm budget (code default is 200). Raise only on Challenge research process.
# GTOS_JEV_MAX_CALLS=500000

# DO NOT set:
# GTOS_JEV_SLEEVE_SELECT_APPLY=1
# GTOS_JEV_ADMISSION_APPLY=1
# order_send / place

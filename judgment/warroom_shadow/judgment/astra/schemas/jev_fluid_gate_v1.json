{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gtos.judgment.astra.jev_fluid_gate_v1",
  "title": "jev_fluid_gate_v1",
  "description": "Shadow-only Challenge fluid-gate cycle log (ALIVE_MENU + CONF_GATE + DONE_OUTSIDE). Never place, remint, flatten, move SL, write chair inbox, or invent NEWS_PROTOCOL. Challenge 0 is the sole payout writer. APPLY is default-off and writes LABEL drafts only behind A1/A2/A3/W_named prove receipts.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "mode",
    "shadow_log_only",
    "never_place",
    "never_remint",
    "never_flatten",
    "account_surface",
    "alive_menu",
    "conf_gate",
    "broker_effect"
  ],
  "properties": {
    "schema": {"const": "jev_fluid_gate_v1"},
    "mode": {"const": "shadow_log_only"},
    "shadow_log_only": {"const": true},
    "never_place": {"const": true},
    "never_remint": {"const": true},
    "never_flatten": {"const": true},
    "never_move_sl": {"const": true},
    "never_write_chair_inbox": {"const": true},
    "namespace": {"const": "gtos.astra.jev_trial.fluid_gate.v1"},
    "broker_effect": {"const": false},
    "account_surface": {
      "type": "object",
      "required": ["login", "pass_target", "role"],
      "properties": {
        "login": {"const": "0"},
        "pass_target": {"const": "$110k"},
        "magic": {"const": "0"},
        "ns": {"const": "operator"},
        "role": {"const": "challenge_calibration"},
        "verification_login_quarantined": {"const": "0"}
      }
    },
    "alive_menu": {
      "type": "object",
      "required": ["rebuilt", "inventory_fingerprint", "criteria"],
      "properties": {
        "rebuilt": {"const": true},
        "inventory_fingerprint": {"type": "string", "minLength": 16}
      }
    },
    "conf_gate": {
      "type": "object",
      "required": ["band", "broker_effect"],
      "properties": {
        "band": {"enum": ["LOW", "MED", "HIGH", "VETO"]},
        "broker_effect": {"const": false}
      }
    },
    "disposition": {
      "type": "string",
      "enum": ["log_only", "label_draft"]
    }
  }
}

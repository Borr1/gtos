# ============================================================================
# Runtime state — orchestrator working files. None of these should be
# committed; they regenerate on each run and create constant diff churn.
# Categories below are documented for the next maintainer.
# ============================================================================

# Per-symbol heartbeat (T1.1 kill switch). Each orchestrator updates its own
# file every M15 candle; staleness = symbol crash signal.
pipeline_state/heartbeat_*.json

# Daemon heartbeats (sibling-daemon-stability fix from 0d3b92a). One per
# auxiliary daemon (heartbeat_monitor, displacement_logger, etc.). Same
# treatment as orchestrator heartbeats — runtime alive-flag, not source.
pipeline_state/daemon_heartbeat_*.json

# T2.8 daily-loss-stop dormant marker. Auto-clears on UTC day rollover at
# orchestrator startup; should not be committed because tests + replays read
# it as authoritative production state (see tests/conftest.py
# _isolate_dormant_state autouse).
pipeline_state/dormant_state.json

# Side-aware sizing SPRT watcher state (rolling LONG-WR window). Created by
# src/components/side_aware_sprt_watcher.py on first LONG outcome.
pipeline_state/side_aware_sprt_state.json

# Per-symbol session state (per-KZ + per-day counters). Tracks
# trades_today/trades_per_kz/etc.; rebuilt every session boot. Different
# per orchestrator process — never source-of-truth.
pipeline_state/session_state_*.json

# Live-monitor agent flags + iteration counter.
pipeline_state/stop_live_monitor.flag
pipeline_state/_monitor_iteration.json

# Notification queue (Telegram bot draining buffer).
pipeline_state/notification_queue.jsonl

# Undelivered-CRITICAL sidecar written by
# src/utils/notification_queue.py::_default_transport when Telegram creds are
# absent. F30 measured it accumulating trade-shaped operator alerts during test
# runs while untracked and unignored — one careless `git add -A` from being
# committed. Runtime dirt, never source of truth.
#
# Scoped to this exact path on purpose. A broader rule such as
# `pipeline_state/**/notification_queue.jsonl` would shadow
# pipeline_state/redacted_account_live_bee34003/notification_queue.jsonl, which IS
# tracked (`git ls-files pipeline_state/`), as are the two halt flags and ~110
# other reload/state artifacts in that tree. Nothing here may mask them.
pipeline_state/UNDELIVERED_CRITICAL_ALERTS.jsonl

# Pending intent / m5 refinement runtime files (orchestrator-managed).
pipeline_state/m5_refinement.json

# Shadow-log streams that grow unboundedly during live operation.

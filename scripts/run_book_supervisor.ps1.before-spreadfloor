# W7 ultimate_book supervisor — keeps BOTH account books alive (auto-restart on crash/exit) with
# single-instance-per-namespace (prevents a double-book = double-trade). Each book is an independent
# run_book.py process (own terminal/namespace/kill-flag/ledger/governor). If the supervisor itself
# dies the books keep running (separate processes); it only starts a book whose process is gone.
#
# Open-position safety: the supervisor only ever STARTS a missing book; it never stops one, so it can
# never orphan an open position. Operator brakes remain the per-account kill flags + the halt flags.
#
#   powershell -ExecutionPolicy Bypass -File scripts\run_book_supervisor.ps1
$ErrorActionPreference = "Continue"
$repo = "C:\Users\MSI\Documents\ai-trading-agent"
$py   = $null
$env:PYTHONPATH = $repo
Set-Location $repo

# ---- liveness heartbeat + self-log ----
# The supervisor can HANG (a Get-CimInstance/WMI call occasionally blocks indefinitely on Windows). The
# old guard only checked "is another supervisor PROCESS alive", so a hung-but-alive incumbent BLOCKED its
# own replacement: every 5-min scheduled-task fire saw the zombie alive and exited -> books/monitor stop
# being respawned with no self-heal (a real multi-hour monitoring outage). The incumbent now stamps a
# heartbeat each loop; a fresh fire reads it and TAKES OVER a stale (hung) incumbent. Self-log to a file
# too (the scheduled-task action has no stdout redirect, so Write-Output alone is lost).
$hbFile  = Join-Path $repo "pipeline_state\supervisor_heartbeat.json"
$mutexName = "Global\GTOS_W7_BookSupervisor"
$logFile = Join-Path $repo "shadow_logs\book_supervisor.log"
$STALE_S = 120   # a healthy loop refreshes every ~35-40s; >120s (~3 missed loops) = hung
$aiHbFile = Join-Path $repo "pipeline_state\ai_companion\heartbeat.json"
$AI_COMPANION_STALE_S = 180   # companion loop is ~60s; >180s = stale/hung
$runtimeAdvisoryFile = Join-Path $repo "pipeline_state\ultimate_book\runtime_learning_advisory\RUNTIME_LEARNING_DAILY_ADVISORY.json"
$RUNTIME_ADVISORY_LOOP_S = 1800
$RUNTIME_ADVISORY_STALE_S = 5400   # 3 missed 30-min refreshes = stale/hung
$BOOK_HEARTBEAT_STALE_S = 240      # book loop is ~60s; >4 missed ticks = stale/hung
$BOOK_STARTUP_GRACE_S = 240        # MT5 startup/login can take time before the first heartbeat
$monitorHbFile = Join-Path $repo "pipeline_state\monitor_books\heartbeat.json"
$MONITOR_HEARTBEAT_STALE_S = 900   # monitor loop is 300s; >3 missed ticks = stale/hung
$MONITOR_STARTUP_GRACE_S = 180

function Write-Hb {
  try {
    $dir = Split-Path $hbFile -Parent
    if (-not (Test-Path $dir)) { New-Item -ItemType Directory -Force -Path $dir | Out-Null }
    $rec = (@{ pid = $PID; ts = (Get-Date).ToUniversalTime().ToString("o") } | ConvertTo-Json -Compress)
    $utf8NoBom = New-Object System.Text.UTF8Encoding $false
    [System.IO.File]::WriteAllText("$hbFile.tmp", $rec, $utf8NoBom)
    Move-Item -Path "$hbFile.tmp" -Destination $hbFile -Force
  } catch {}
}
function Log-Sup([string]$m) {
  $line = ("{0} {1}" -f (Get-Date -Format o), $m)
  Write-Output $line
  try { Add-Content -Path $logFile -Value $line -Encoding utf8 } catch {}
}

function Resolve-PythonExe {
  $candidate = Join-Path $repo ".venv-gtos\Scripts\python.exe"
  if (Test-Path $candidate) { return $candidate }
  try {
    $cmd = Get-Command python.exe -ErrorAction Stop
    if ($cmd -and $cmd.Source) {
      Log-Sup ("venv python missing at {0}; using PATH python {1}" -f $candidate, $cmd.Source)
      return [string]$cmd.Source
    }
  } catch {}
  Log-Sup ("fatal: python executable not found at {0} and python.exe not on PATH" -f $candidate)
  exit 1
}

function Get-PythonRuntimeProcesses {
  @(Get-CimInstance Win32_Process -Filter "Name='python.exe' OR Name='pythonw.exe'" -ErrorAction SilentlyContinue)
}

function Start-ChildShell([string]$label, [string]$command) {
  try {
    $child = Start-Process -FilePath "powershell.exe" `
      -ArgumentList @("-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", $command) `
      -WorkingDirectory $repo -WindowStyle Hidden -PassThru
    if ($child -and $child.Id) {
      Log-Sup ("started {0} wrapper pid={1}" -f $label, $child.Id)
      return $child
    }
    Log-Sup ("start returned no process for {0}" -f $label)
    return $null
  } catch {
    Log-Sup ("failed to start {0}: {1}" -f $label, $_.Exception.Message)
    return $null
  }
}

function Read-SupervisorHeartbeat {
  if (-not (Test-Path $hbFile)) { return $null }
  try {
    $hb = Get-Content $hbFile -Raw -ErrorAction Stop | ConvertFrom-Json
    $age = ((Get-Date).ToUniversalTime() - ([datetime]$hb.ts).ToUniversalTime()).TotalSeconds
    return [pscustomobject]@{ pid = [int]$hb.pid; age_seconds = $age; ts = [string]$hb.ts }
  } catch {
    return $null
  }
}

function Try-AcquireSupervisorLock {
  try {
    if ($null -eq $script:SupervisorMutex) {
      $createdNew = $false
      $script:SupervisorMutex = New-Object System.Threading.Mutex(
        $false,
        $mutexName,
        [ref]$createdNew
      )
    }
    return $script:SupervisorMutex.WaitOne(0)
  } catch [System.Threading.AbandonedMutexException] {
    Log-Sup "supervisor mutex abandoned; acquired ownership"
    return $true
  } catch {
    return $false
  }
}

$py = Resolve-PythonExe

if (-not (Try-AcquireSupervisorLock)) {
  $hb = Read-SupervisorHeartbeat
  if ($hb -and $hb.age_seconds -le $STALE_S) {
    Log-Sup ("supervisor lock held by fresh heartbeat pid {0} (hb {1:n0}s); single-instance exit" -f $hb.pid, $hb.age_seconds)
    exit 0
  }
  if ($hb -and $hb.pid -gt 0) {
    Log-Sup ("supervisor lock held but heartbeat stale/missing; killing pid {0} and taking over" -f $hb.pid)
    try { Stop-Process -Id $hb.pid -Force -ErrorAction SilentlyContinue } catch {}
    Start-Sleep -Seconds 2
  }
  if (-not (Try-AcquireSupervisorLock)) {
    Log-Sup "supervisor lock still unavailable after stale takeover attempt; exiting"
    exit 1
  }
}
Write-Hb   # claim incumbency before any process scan that might hang

$books = @(
  @{ ns="operator_profile";    profile="operator_profile"; term="C:\MT5\FTMO\terminal64.exe";       kill="pipeline_state/ULTIMATE_BOOK_KILL_ftmo.flag"; log="shadow_logs\run_book_console.log"; tags="crypto,energy_agri,sub_xvol_pullback,sub_mid_dn_revert,mx_btcusd_d1_donchian_20_breakout"; frontier="mx_btcusd_d1_donchian_20_breakout" },
  @{ ns="redacted_account_live_bee34003"; profile="redacted_account";            term="C:\MT5\redacted_account\terminal64.exe"; kill="pipeline_state/ULTIMATE_BOOK_KILL_fn.flag";   log="shadow_logs\run_book_fn_console.log"; tags="crypto,energy_agri,sub_xvol_pullback,sub_mid_dn_revert" }
)

function Read-BookHeartbeat([string]$ns) {
  $path = Join-Path $repo ("pipeline_state\ultimate_book\{0}\heartbeat.json" -f $ns)
  if (-not (Test-Path $path)) { return $null }
  try {
    $hb = Get-Content $path -Raw -ErrorAction Stop | ConvertFrom-Json
    $ts = [datetimeoffset]::Parse([string]$hb.ts).UtcDateTime
    $age = ((Get-Date).ToUniversalTime() - $ts).TotalSeconds
    $healthy = $true
    if ($null -ne $hb.healthy) { $healthy = [bool]$hb.healthy }
    return [pscustomobject]@{
      pid = [int]$hb.pid
      age_seconds = $age
      healthy = $healthy
      ts = [string]$hb.ts
      path = $path
    }
  } catch {
    return $null
  }
}

function Read-BookPidFile([string]$ns) {
  $path = Join-Path $repo ("pipeline_state\ultimate_book\{0}\run_book.pid" -f $ns)
  if (-not (Test-Path $path)) { return 0 }
  try {
    return [int]((Get-Content $path -Raw -ErrorAction Stop).Trim())
  } catch {
    return 0
  }
}

function Test-BookRunning([string]$ns) {
  $procs = Get-PythonRuntimeProcesses |
           Where-Object { $_.CommandLine -like "*run_book.py*" -and $_.CommandLine -like "*--namespace $ns*" }
  $procs = @($procs)
  if ($procs.Count -eq 0) { return $false }

  $hb = Read-BookHeartbeat $ns
  $pidFilePid = Read-BookPidFile $ns
  $preferredPid = 0
  if ($hb -and $hb.pid -gt 0) { $preferredPid = [int]$hb.pid }
  elseif ($pidFilePid -gt 0) { $preferredPid = [int]$pidFilePid }

  $livePids = @($procs | ForEach-Object { [int]$_.ProcessId })
  $preferredLive = ($preferredPid -gt 0 -and ($livePids -contains $preferredPid))
  $young = @($procs | Where-Object {
    $age = Get-ProcessAgeSeconds $_
    ($null -ne $age) -and ($age -lt $BOOK_STARTUP_GRACE_S)
  })

  if ($hb -and ($hb.age_seconds -le $BOOK_HEARTBEAT_STALE_S) -and $preferredLive) {
    if (-not $hb.healthy) {
      Log-Sup ("book ns={0} heartbeat fresh but broker health=false; keeping worker alive for reconnect/monitor alert" -f $ns)
    }
    return $true
  }

  if ($young.Count -gt 0) {
    if ($hb -and $preferredPid -gt 0 -and -not $preferredLive) {
      Log-Sup ("book ns={0} heartbeat pid {1} not live yet/anymore; startup grace live pids={2}" -f $ns, $preferredPid, ($livePids -join ","))
    }
    return $true
  }

  if ($hb -and ($hb.age_seconds -gt $BOOK_HEARTBEAT_STALE_S)) {
    Log-Sup ("book ns={0} stale heartbeat age={1:n0}s > {2}s; alert_only_no_forced_restart open_position_safety live pids={3}" -f $ns, $hb.age_seconds, $BOOK_HEARTBEAT_STALE_S, ($livePids -join ","))
  } elseif ($hb -and -not $preferredLive) {
    Log-Sup ("book ns={0} heartbeat pid {1} is not live; alert_only_no_forced_restart open_position_safety live pids={2}" -f $ns, $preferredPid, ($livePids -join ","))
  } else {
    Log-Sup ("book ns={0} has run_book pids but no usable heartbeat after startup grace; alert_only_no_forced_restart open_position_safety live pids={1}" -f $ns, ($livePids -join ","))
  }
  return $true
}

function Get-CimProcessById([int]$ProcessId) {
  try {
    return Get-CimInstance Win32_Process -Filter ("ProcessId = {0}" -f $ProcessId) -ErrorAction SilentlyContinue
  } catch {
    return $null
  }
}

function Test-ProcessOwnedBySupervisor($proc) {
  try {
    $current = $proc
    $seen = @{}
    for ($depth = 0; $depth -lt 6; $depth++) {
      if ($null -eq $current) { return $false }
      $currentPid = [int]$current.ProcessId
      if ($currentPid -eq [int]$PID) { return $true }
      if ($seen.ContainsKey([string]$currentPid)) { return $false }
      $seen[[string]$currentPid] = $true
      $parentPid = [int]$current.ParentProcessId
      if ($parentPid -eq [int]$PID) { return $true }
      if ($parentPid -le 0) { return $false }
      $current = Get-CimProcessById $parentPid
    }
    return $false
  } catch {
    return $false
  }
}

function Stop-StaleSupervisorGenerationProcesses($procs, [string]$label) {
  foreach ($p in @($procs)) {
    try {
      if ($null -eq $p -or $null -eq $p.ProcessId) { continue }
      Log-Sup ("stopping stale {0} pid={1}: not owned by current supervisor pid={2}" -f $label, $p.ProcessId, $PID)
      Stop-Process -Id $p.ProcessId -Force -ErrorAction SilentlyContinue
    } catch {}
  }
}

function Filter-CurrentSupervisorGeneration($procs, [string]$label) {
  $all = @($procs | Where-Object { $null -ne $_ -and $null -ne $_.ProcessId })
  if ($all.Count -eq 0) { return @() }
  $owned = @($all | Where-Object { Test-ProcessOwnedBySupervisor $_ })
  $unowned = @($all | Where-Object { -not (Test-ProcessOwnedBySupervisor $_) })
  if ($unowned.Count -gt 0) {
    Stop-StaleSupervisorGenerationProcesses $unowned $label
  }
  if ($owned.Count -gt 0) { return $owned }
  return @()
}

function Test-MonitorRunning {
  $procs = Get-PythonRuntimeProcesses |
           Where-Object { $_.CommandLine -like "*monitor_books.py*--loop*" }
  $owned = @(Filter-CurrentSupervisorGeneration -procs @($procs) -label "monitor daemon")
  if ($owned.Count -eq 0) { return $false }
  $young = @($owned | Where-Object {
    $age = Get-ProcessAgeSeconds $_
    ($null -ne $age) -and ($age -lt $MONITOR_STARTUP_GRACE_S)
  })
  if (-not (Test-Path $monitorHbFile)) {
    if ($young.Count -gt 0) { return $true }
    Stop-StaleSupervisorGenerationProcesses $owned "monitor daemon missing heartbeat"
    return $false
  }
  $hbPid = $null; $hbAge = $null
  try {
    $hb = Get-Content $monitorHbFile -Raw -ErrorAction Stop | ConvertFrom-Json
    if ($hb.pid) { $hbPid = [int]$hb.pid }
    $hbTs = [datetimeoffset]::Parse([string]$hb.ts).UtcDateTime
    $hbAge = ((Get-Date).ToUniversalTime() - $hbTs).TotalSeconds
  } catch {
    if ($young.Count -gt 0) { return $true }
    Stop-StaleSupervisorGenerationProcesses $owned "monitor daemon unreadable heartbeat"
    return $false
  }
  if (($null -eq $hbAge) -or ($hbAge -gt $MONITOR_HEARTBEAT_STALE_S)) {
    Stop-StaleSupervisorGenerationProcesses $owned ("monitor daemon stale heartbeat age={0:n0}s > {1}s" -f $hbAge, $MONITOR_HEARTBEAT_STALE_S)
    return $false
  }
  if ($hbPid -and (@($owned | ForEach-Object { $_.ProcessId }) -contains $hbPid)) {
    return $true
  }
  if ($hbPid) {
    $livePids = ((@($owned | ForEach-Object { $_.ProcessId })) -join ",")
    if ($young.Count -gt 0) {
      Log-Sup ("monitor heartbeat pid {0} is not one of live pids: {1}; within startup grace" -f $hbPid, $livePids)
      return $true
    }
    Stop-StaleSupervisorGenerationProcesses $owned ("monitor daemon heartbeat pid {0} is not one of live pids: {1}" -f $hbPid, $livePids)
    return $false
  }
  return $true
}

function Get-AICompanionProcesses {
  @(Get-PythonRuntimeProcesses |
    Where-Object { $_.CommandLine -like "*run_ai_companion_supervisor.py*" })
}

function Stop-AICompanionProcesses($procs, [string]$reason) {
  foreach ($p in @($procs)) {
    try {
      Log-Sup ("stopping stale AI companion pid={0}: {1}" -f $p.ProcessId, $reason)
      Stop-Process -Id $p.ProcessId -Force -ErrorAction SilentlyContinue
    } catch {}
  }
}

function Get-ProcessAgeSeconds($proc) {
  try {
    if ($null -eq $proc.CreationDate) { return $null }
    return ((Get-Date).ToUniversalTime() - $proc.CreationDate.ToUniversalTime()).TotalSeconds
  } catch {
    return $null
  }
}

function Test-AICompanionRunning {
  $procs = @(Get-AICompanionProcesses)
  if ($procs.Count -eq 0) { return $false }
  $procs = @(Filter-CurrentSupervisorGeneration -procs @($procs) -label "AI companion")
  if ($procs.Count -eq 0) { return $false }
  $young = @($procs | Where-Object {
    $age = Get-ProcessAgeSeconds $_
    ($null -ne $age) -and ($age -lt $AI_COMPANION_STALE_S)
  })
  if (-not (Test-Path $aiHbFile)) {
    if ($young.Count -gt 0) { return $true }
    Stop-AICompanionProcesses $procs "missing heartbeat"
    return $false
  }
  $hbPid = $null; $hbAge = $null
  try {
    $hb = Get-Content $aiHbFile -Raw -ErrorAction Stop | ConvertFrom-Json
    if ($hb.pid) { $hbPid = [int]$hb.pid }
    $hbTs = [datetimeoffset]::Parse([string]$hb.ts).UtcDateTime
    $hbAge = ((Get-Date).ToUniversalTime() - $hbTs).TotalSeconds
  } catch {
    if ($young.Count -gt 0) { return $true }
    Stop-AICompanionProcesses $procs "unreadable heartbeat"
    return $false
  }
  if (($null -eq $hbAge) -or ($hbAge -gt $AI_COMPANION_STALE_S)) {
    Stop-AICompanionProcesses $procs ("stale heartbeat age={0:n0}s > {1}s" -f $hbAge, $AI_COMPANION_STALE_S)
    return $false
  }
  if ($hbPid -and (@($procs | ForEach-Object { $_.ProcessId }) -contains $hbPid)) {
    return $true
  }
  if ($hbPid -and -not (@($procs | ForEach-Object { $_.ProcessId }) -contains $hbPid)) {
    $livePids = ((@($procs | ForEach-Object { $_.ProcessId })) -join ",")
    if ($young.Count -gt 0) {
      Log-Sup ("AI companion heartbeat pid {0} is not one of live pids: {1}; within startup grace" -f $hbPid, $livePids)
      return $true
    }
    Stop-AICompanionProcesses $procs ("heartbeat pid {0} is not one of live pids: {1}" -f $hbPid, $livePids)
    return $false
  }
  return $true
}

function Get-RuntimeLearningAdvisoryProcesses {
  @(Get-PythonRuntimeProcesses |
    Where-Object {
      $_.CommandLine -like "*build_runtime_learning_daily_advisory.py*" -and
      $_.CommandLine -like "*--loop-seconds*"
    })
}

function Stop-RuntimeLearningAdvisoryProcesses($procs, [string]$reason) {
  foreach ($p in @($procs)) {
    try {
      Log-Sup ("stopping stale runtime-learning advisory pid={0}: {1}" -f $p.ProcessId, $reason)
      Stop-Process -Id $p.ProcessId -Force -ErrorAction SilentlyContinue
    } catch {}
  }
}

function Test-RuntimeLearningAdvisoryRunning {
  $procs = @(Get-RuntimeLearningAdvisoryProcesses)
  if ($procs.Count -eq 0) { return $false }
  $procs = @(Filter-CurrentSupervisorGeneration -procs @($procs) -label "runtime-learning advisory")
  if ($procs.Count -eq 0) { return $false }
  $young = @($procs | Where-Object {
    $age = Get-ProcessAgeSeconds $_
    ($null -ne $age) -and ($age -lt $RUNTIME_ADVISORY_STALE_S)
  })
  if (-not (Test-Path $runtimeAdvisoryFile)) {
    if ($young.Count -gt 0) { return $true }
    Stop-RuntimeLearningAdvisoryProcesses $procs "missing advisory output"
    return $false
  }
  $ageSeconds = $null
  try {
    $advisory = Get-Content $runtimeAdvisoryFile -Raw -ErrorAction Stop | ConvertFrom-Json
    $generated = [datetimeoffset]::Parse([string]$advisory.generated_at_utc).UtcDateTime
    $ageSeconds = ((Get-Date).ToUniversalTime() - $generated).TotalSeconds
  } catch {
    if ($young.Count -gt 0) { return $true }
    Stop-RuntimeLearningAdvisoryProcesses $procs "unreadable advisory output"
    return $false
  }
  if (($null -eq $ageSeconds) -or ($ageSeconds -gt $RUNTIME_ADVISORY_STALE_S)) {
    Stop-RuntimeLearningAdvisoryProcesses $procs ("stale advisory age={0:n0}s > {1}s" -f $ageSeconds, $RUNTIME_ADVISORY_STALE_S)
    return $false
  }
  return $true
}

Log-Sup ("book supervisor starting (pid {0}; ns: {1})" -f $PID, ($books.ns -join ", "))
while ($true) {
  Write-Hb   # FIRST each loop: if the tick then hangs in a CIM call the heartbeat goes STALE -> a fresh fire takes over
  foreach ($b in $books) {
    if (-not (Test-BookRunning $b.ns)) {
      Log-Sup ("(re)starting book ns={0}" -f $b.ns)
      $tagArg = if ($b.tags) { " --tags `"" + $b.tags + "`"" } else { "" }
    $frontArg = if ($b.frontier) { " --frontier-exits `"" + $b.frontier + "`"" } else { "" }
      $bookCommand = "& `"$py`" `"run_book.py`" --terminal-path `"$($b.term)`" --namespace `"$($b.ns)`" --profile `"$($b.profile)`" --kill-flag `"$($b.kill)`"$tagArg$frontArg --poll-seconds `"60`" 1>> `"$($b.log)`" 2>> `"$($b.log).err`""
      Start-ChildShell ("book ns={0}" -f $b.ns) $bookCommand | Out-Null
      Start-Sleep -Seconds 3
    }
  }
  if (-not (Test-MonitorRunning)) {
    Log-Sup "(re)starting monitor daemon"
    $monitorCommand = "& `"$py`" `".tools\monitor_books.py`" --loop `"300`" 1>> `"shadow_logs\monitor_daemon.log`" 2>> `"shadow_logs\monitor_daemon.err`""
    Start-ChildShell "monitor daemon" $monitorCommand | Out-Null
  }
  if (-not (Test-AICompanionRunning)) {
    Log-Sup "(re)starting AI companion supervisor"
    $aiCommand = "& `"$py`" `"scripts\run_ai_companion_supervisor.py`" 1>> `"shadow_logs\ai_companion_supervisor.log`" 2>> `"shadow_logs\ai_companion_supervisor.err`""
    Start-ChildShell "AI companion supervisor" $aiCommand | Out-Null
  }
  if (-not (Test-RuntimeLearningAdvisoryRunning)) {
    Log-Sup "(re)starting runtime-learning advisory refresher"
    $advCommand = "& `"$py`" `"scripts\build_runtime_learning_daily_advisory.py`" --loop-seconds `"$RUNTIME_ADVISORY_LOOP_S`" 1>> `"shadow_logs\runtime_learning_advisory.log`" 2>> `"shadow_logs\runtime_learning_advisory.err`""
    Start-ChildShell "runtime-learning advisory refresher" $advCommand | Out-Null
  }
  Start-Sleep -Seconds 30
}

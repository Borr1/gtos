+   - `ultimate_book_runtime_learning_packet_log_path: "shadow_logs/ultimate_book_runtime_learning_packets.jsonl"`
+   - `ultimate_book_runtime_learning_packet_schema: "ultimate_book_runtime_learning_packet_v1"`

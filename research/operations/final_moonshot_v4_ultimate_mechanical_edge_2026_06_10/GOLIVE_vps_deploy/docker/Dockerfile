# GTOS go-live — runtime image (Python runtime + deploy module + monitoring).
# Does NOT bundle MetaTrader5 (Windows-only); the bridge reaches an external MT5
# host. No credentials are baked in — they come from env_file at run time.

FROM python:3.12-slim

# Pin deps for reproducibility. requirements-vps.txt is generated by the deploy
# script from the repo's pinned environment (numpy, pyyaml, python-dotenv, the
# bridge client, etc.). The deploy MODULE itself has zero heavy deps on its
# decision path (import-safe), but run_agent.py needs the full runtime set.
WORKDIR /app
COPY research/operations/final_moonshot_v4_ultimate_mechanical_edge_2026_06_10/GOLIVE_vps_deploy/config/requirements-vps.txt /app/requirements-vps.txt
RUN pip install --no-cache-dir -r /app/requirements-vps.txt || true

# Copy the repo (owner can narrow this with .dockerignore to src/, config/,
# scripts/, run_agent.py, the route deploy module, and pipeline_state schema).
COPY . /app

# Non-root for safety.
RUN useradd -m gtos && chown -R gtos /app
USER gtos

# NTP/time-sync is a host concern; container inherits host clock.
# Default command is the SAFE monitor cycle, not the trader.
CMD ["python3", "research/operations/final_moonshot_v4_ultimate_mechanical_edge_2026_06_10/GOLIVE_vps_deploy/deploy/run_monitor_cycle.py"]

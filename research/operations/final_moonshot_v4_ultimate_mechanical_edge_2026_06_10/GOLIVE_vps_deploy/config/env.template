# GTOS go-live — VPS environment / secrets TEMPLATE
# ---------------------------------------------------------------------------
# Copy to `.env` ON THE VPS ONLY. NEVER commit the filled file (it is gitignored
# at the repo root via .env*). NO real credentials live in this template.
# The owner fills every <PLACEHOLDER> on the VPS.
# ---------------------------------------------------------------------------

# --- Broker / MT5 credentials (OWNER SUPPLIES on the VPS) ---
GTOS_MT5_LOGIN=<FTMO_ACCOUNT_LOGIN>
GTOS_MT5_PASSWORD=<FTMO_ACCOUNT_PASSWORD>
GTOS_MT5_SERVER=<FTMO_SERVER_e.g._FTMO-Server3>
GTOS_MT5_TERMINAL_PATH=<C:\MT5\FTMO\terminal64.exe>

# --- Bridge transport (siliconmetatrader5 / nmetatrader5 localhost bridge) ---
GTOS_BRIDGE_HOST=127.0.0.1
GTOS_BRIDGE_PORT=8001
GTOS_BRIDGE_TRANSPORT=nmetatrader5_bridge   # or local_mt5

# --- Prop-firm profile + account namespace (matches config/profiles/*.yaml) ---
GTOS_PROFILE=ftmo
GTOS_PROFILE_NAMESPACE=<ftmo_server3_xxxxxxxx>

# --- Sizing dial (owner-chosen; see PORTFOLIO_BUILD_W7_FINAL.md §6) ---
# First cycle 1.25% -> 1.50% after first account clears -> ceiling 2.00%.
GTOS_SIZE_PROFILE=clean3_firstcycle_eff1p18   # staged in patch; see patches/
GTOS_KELLY_LITE=true
GTOS_KELLY_CONSERVATIVE=true                   # half-Kelly first cycle (breach-free)
GTOS_STRESS_DERISK=true

# --- DD-defense shape (research c59/c61 upgrade; admission.py reads this AT IMPORT) ---
# "band"  = current live (full size to -7% DD, then linear to 0 at the -10% wall).
# "smooth"= de-risk proportionally from dd=0 (size *= 1-dd_frac): holds total-DD-fail ~0 at a higher
#           base -> faster AND safer passes. REQUIRED to run the 2.00% ceiling profile (admission.py
#           fails closed on the ceiling dial without it). Owner-approved 2026-06-15.
# Set this BEFORE the run_book.py process starts (DEFAULT_LIMITS binds at import); restart to change.
GTOS_UB_DERISK_MODE=band                        # flip to "smooth" to activate the c61 upgrade

# --- Gates (ALL must be true AND halt flags cleared before any connect) ---
# These mirror the repo triple-gate. DEFAULT FALSE. Owner flips at go-live.
GTOS_LIVE_CONNECT_ALLOWED=false

# --- LLM (only if the live runtime uses it; the deploy module does NOT) ---
ANTHROPIC_API_KEY=<OPTIONAL_only_if_runtime_uses_llm>

# --- Owner alerting (optional webhook; monitor.send_alert reads it) ---
GTOS_ALERT_WEBHOOK=<OPTIONAL_https_endpoint_for_telegram_slack_push>

# --- NTP / time-sync is a VPS-OS concern, not an env var (see deploy README). ---
